{
  "Jwt": {
    "Issuer": "ScanPlantAPI",
    "Audience": "ScanPlantApp"
  },
  "ExternalFallback": {
    "MaxImageBytes": 5242880,
    "MaxImageWidth": 4096,
    "MaxImageHeight": 4096,
    "RequestTimeoutSeconds": 20,
    "RateLimitPermitLimit": 10,
    "RateLimitWindowSeconds": 60,
    "AllowedMediaTypes": [
      "image/jpeg",
      "image/png"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
