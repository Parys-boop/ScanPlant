                }

                var score = result.TryGetProperty("score", out var scoreProperty) && scoreProperty.TryGetDecimal(out var parsedScore)
                    ? parsedScore
                    : 0m;
                candidates.Add(new PlantIdentificationCandidate(scientificName, commonName, score));
