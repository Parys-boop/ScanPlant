        }

        if (!response.IsSuccessStatusCode)
        {
            throw new ExternalProviderUnavailableException(
                "plantnet",
                (int)response.StatusCode >= 500 ? StatusCodes.Status503ServiceUnavailable : StatusCodes.Status502BadGateway);
        }

        try
