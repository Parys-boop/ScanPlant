# Configuração da API
# Para desenvolvimento local, use:
# VITE_API_URL=http://localhost:5041/api

# Para produção com ngrok, use:
# VITE_API_URL=https://SEU-CODIGO-NGROK.ngrok.io/api

# Para produção com backend deployado, use:
# VITE_API_URL=https://seu-backend.azurewebsites.net/api

VITE_API_URL=http://localhost:5041/api

# Chaves externas usadas pelo front-end.
# Copie este arquivo para .env.local e preencha localmente.
# Nunca commit .env.local.
VITE_PLANT_ID_API_KEY=coloque_sua_chave_plant_id_aqui
VITE_GEMINI_API_KEY=coloque_sua_chave_gemini_aqui
VITE_GEMINI_MODEL=gemini-2.5-flash
