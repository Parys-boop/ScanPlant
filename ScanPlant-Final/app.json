{
  "expo": {
    "name": "scanplantapp",
    "slug": "scanplant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Este aplicativo precisa acessar a câmera para tirar fotos de plantas.",
        "NSPhotoLibraryUsageDescription": "Este aplicativo precisa acessar a galeria para selecionar fotos de plantas.",
        "NSLocationWhenInUseUsageDescription": "Este aplicativo precisa acessar sua localização para mostrar onde as plantas foram encontradas."
      },
      "config": {
        "googleMapsApiKey": "GOOGLE_MAPS_API_KEY_HERE"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_MEDIA_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_API_KEY_HERE"
        }
      },
      "package": "com.parysboop.scanplant"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "979ef23a-b962-4098-8e88-38d4d0c07b40"
      }
    },
    "owner": "josevaldo"
  }
}
